{
  "manifest_version": 3,
  "name": "waveroute.pins — Pinterest Downloader",
  "short_name": "waveroute.pins",
  "version": "1.0.0",
  "description": "Download Pinterest board images in full original resolution with custom limits, ZIP export, and Figma link copy.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon48.png",
    "default_title": "waveroute.pins"
  },
  "background": {
    "service_worker": "background/background.js",
    "scripts": ["background/background.js"]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*.pinterest.ca/*",
    "https://*.pinterest.co.uk/*",
    "https://*.pinterest.fr/*",
    "https://*.pinterest.de/*",
    "https://*.pinterest.es/*",
    "https://*.pinterest.it/*",
    "https://*.pinterest.jp/*",
    "https://*.pinterest.ru/*",
    "https://*.pinimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.ru/*"
      ],
      "js": ["content/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "waveroute-pins@waveroute.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
